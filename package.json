{
  "name": "openschedule-calendar",
  "version": "0.1.0",
  "description": "Independent resource scheduling engine and accessible browser calendar",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./style.css": "./src/style.css"
  },
  "files": [
    "dist",
    "src",
    "examples",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "demo": "node demo/server.mjs",
    "prepack": "npm run build",
    "format": "prettier --write src tests demo examples docs README.md package.json tsconfig.json playwright.config.js",
    "format:check": "prettier --check src tests demo examples docs README.md package.json tsconfig.json playwright.config.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ishangupta-1510/openschedule.git"
  },
  "bugs": {
    "url": "https://github.com/ishangupta-1510/openschedule/issues"
  },
  "homepage": "https://github.com/ishangupta-1510/openschedule#readme"
}
